{
  "name": "retail-pos",
  "version": "0.5.2",
  "license": "Apache-2.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android --non-interactive",
    "ios": "expo start --ios --clear",
    "web": "expo start --web",
    "desktop": "NODE_ENV=development concurrently \"expo start --web --port 19006\" \"wait-on http://localhost:19006 && electron electron/main.js\"",
    "desktop:dev": "NODE_ENV=development electron electron/main.js",
    "desktop:build": "expo export --platform web && electron-builder --publish=never",
    "desktop:build-win": "expo export --platform web && electron-builder --win --publish=never",
    "desktop:build-mac": "expo export --platform web && electron-builder --mac --publish=never",
    "desktop:build-linux": "expo export --platform web && electron-builder --linux --publish=never",
    "test": "jest --config tests/jest.config.js --no-coverage",
    "test:unit": "jest --config tests/jest.config.js --no-coverage",
    "test:integration": "jest --config tests/jest.integration.config.js --no-coverage",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:watch": "jest --config tests/jest.config.js --watch",
    "test:coverage": "jest --config tests/jest.config.js --coverage",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:patch": "standard-version --release-as patch",
    "latest": "yarn upgrade --latest && npx expo install --fix",
    "doctor": "npx expo-doctor",
    "lint": "npx tsc --noEmit && eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "npx tsc --noEmit && eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:errors": "eslint . --ext .js,.jsx,.ts,.tsx --quiet",
    "depnedency:check": "npx expo install --check",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@adyen/react-native": "^2.12.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "7.18.14",
    "@react-navigation/native": "7.3.14",
    "@react-navigation/native-stack": "7.18.6",
    "@react-navigation/stack": "7.10.17",
    "@shopify/flash-list": "2.0.2",
    "@stripe/stripe-terminal-react-native": "0.0.1-beta.31",
    "@tillpos/rn-receipt-printer-utils": "1.0.2",
    "card-react-native": "1.0.8",
    "eventemitter3": "5.0.4",
    "expo": "~57.0.8",
    "expo-camera": "~57.0.3",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-localization": "57.0.1",
    "expo-sharing": "^57.0.7",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "57.0.1",
    "expo-status-bar": "~57.0.1",
    "i18next": "26.3.6",
    "lodash.debounce": "^4.0.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "17.0.11",
    "react-native": "0.86.0",
    "react-native-ble-plx": "3.5.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-http-bridge": "^0.6.1",
    "react-native-keychain": "10.0.0",
    "react-native-logs": "5.6.0",
    "react-native-nitro-modules": "^0.36.3",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-square-in-app-payments": "^2.1.0",
    "react-native-vision-camera": "5.2.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.0",
    "react-native-worklets-core": "^1.6.3",
    "uuid": "^14.0.1",
    "winston": "3.19.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "10.0.1",
    "@types/jest": "~29.5.14",
    "@types/lodash.debounce": "^4.0.9",
    "@types/react": "~19.2.17",
    "@types/react-native-square-in-app-payments": "1.4.4",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "lint-staged": "^17.2.0",
    "prettier": "3.9.6",
    "react-native-dotenv": "4.1.0",
    "standard-version": "^9.5.0",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3",
    "wait-on": "^9.1.0"
  },
  "homepage": "./",
  "build": {
    "appId": "com.retail-pos.desktop",
    "productName": "RetailPOS",
    "directories": {
      "output": "dist-electron"
    },
    "extends": null,
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "extraResources": [
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@stripe/stripe-terminal-react-native",
          "@tillpos/rn-receipt-printer-utils",
          "react-native-square-in-app-payments",
          "react-native-esc-pos-printer",
          "react-native-http-bridge"
        ]
      }
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "yarn lint:fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "standard-version": {
    "types": [
      {
        "type": "feat",
        "section": "Features"
      },
      {
        "type": "fix",
        "section": "Bug Fixes"
      },
      {
        "type": "perf",
        "section": "Performance"
      },
      {
        "type": "refactor",
        "section": "Refactoring"
      },
      {
        "type": "test",
        "section": "Tests"
      },
      {
        "type": "chore",
        "hidden": true
      },
      {
        "type": "docs",
        "hidden": true
      },
      {
        "type": "style",
        "hidden": true
      }
    ],
    "skip": {
      "changelog": false
    }
  }
}
